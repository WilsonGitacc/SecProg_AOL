# ==============================================================================
# Secure Neo-Brutalist LMS - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Do NOT commit .env to version control.
# 2. Run 'php scripts/generate_env.php' to automatically generate a secure .env
#    with high-entropy random passwords and cryptographic keys.
# ==============================================================================

# --- Application Environment ---
APP_NAME="Secure Neo-Brutalist LMS"
APP_ENV=production
APP_DEBUG=0
APP_URL=https://localhost:8443
HTTP_PORT=80
HTTPS_PORT=8443
APP_KEY=replace_with_256bit_random_key_via_generate_env_script

# --- Database Credentials (MySQL 8.4 LTS) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=secure_lms

# Container Setup Root Password (used only by MySQL initialization)
DB_ROOT_PASSWORD=replace_with_strong_random_root_password

# Migrator Account: DDL + DML privileges for schema migrations and seeder
DB_MIGRATOR_USER=lms_migrator
DB_MIGRATOR_PASSWORD=replace_with_strong_random_migrator_password

# Application Account: STRICTLY DML ONLY (SELECT, INSERT, UPDATE, DELETE)
DB_USER=lms_app
DB_PASSWORD=replace_with_strong_random_app_password

# --- Storage & Upload Configuration ---
UPLOAD_MAX_FILESIZE=10M
UPLOAD_STORAGE_PATH=/var/www/html/storage/uploads
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,zip
UPLOAD_ALLOWED_MIMES=application/pdf,image/png,image/jpeg,text/plain,application/zip

# --- Session Security ---
SESSION_NAME=SECURE_LMS_SESSID
SESSION_LIFETIME=1800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- Security Controls & Rate Limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_LIFETIME=3600
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=4
ARGON2_THREADS=1

# --- Application Constants ---
MAX_VISIBLE_SESSIONS=3
DEFAULT_TIMEZONE=Asia/Jakarta
