{
  "name": "secure-lms/app",
  "description": "Secure Neo-Brutalist Learning Management System (LMS)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "./scripts/run_tests.sh",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/import_lms_data.php",
    "generate-env": "php scripts/generate_env.php"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {}
  }
}
