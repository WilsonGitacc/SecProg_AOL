[mysqld]
# Identity & Networking
user = mysql
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid
bind-address = 0.0.0.0
port = 3306
skip-name-resolve = 1

# Security Hardening (MySQL 8.4 LTS)
local-infile = 0
symbolic-links = 0
secure-file-priv = /var/lib/mysql-files
log_bin_trust_function_creators = 1

# Character Sets & Collation
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Memory & Buffer Management (optimized for container limits)
innodb_buffer_pool_size = 256M
innodb_file_per_table = 1
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
max_connections = 100
max_connect_errors = 10
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600

# Strict SQL Standards Mode
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY

# Error Logging (standard container stderr output)
log-error = stderr
slow_query_log = 0

[client]
default-character-set = utf8mb4
socket = /var/run/mysqld/mysqld.sock

[mysql]
default-character-set = utf8mb4
